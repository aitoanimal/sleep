<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <title>睡眠管理アプリ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    /* spicato っぽいシンプルで上品なデザイン */

    :root {
      --bg: #fafafa;
      --text-main: #111111;
      --text-sub: #777777;
      --border: #dddddd;
      --button-bg: #000000;
      --button-text: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: var(--bg);
      font-family: "Helvetica Neue", system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", sans-serif;
      color: var(--text-main);
    }

    .app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
    }

    h1 {
      font-weight: 300;
      letter-spacing: 0.08em;
      margin-bottom: 24px;
      font-size: 24px;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 24px 20px;
      max-width: 420px;
      width: 100%;
      background: #ffffff;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .cat {
      width: 180px;
      height: 180px;
      margin: 0 auto 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: #f3f3f3;
      font-size: 64px;
    }

    .info {
      margin-top: 12px;
      font-size: 14px;
      color: var(--text-sub);
      line-height: 1.6;
    }

    .sleep-time {
      margin-top: 12px;
      font-size: 16px;
      font-weight: 300;
    }

    button {
      margin-top: 20px;
      padding: 12px 32px;
      border-radius: 999px;
      border: none;
      background: var(--button-bg);
      color: var(--button-text);
      font-size: 16px;
      letter-spacing: 0.08em;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    button:disabled {
      opacity: 0.4;
      cursor: default;
    }

    button:hover:not(:disabled) {
      opacity: 0.8;
    }

    .subtext {
      margin-top: 8px;
      font-size: 13px;
      color: var(--text-sub);
    }
  </style>
</head>
<body>
  <div class="app">
    <div class="card">
      <h1>睡眠管理</h1>

      <div id="cat" class="cat">😴</div>

      <div id="status" class="info">
        寝る前に「寝る」ボタンをタップしてください。
      </div>

      <div id="sleepTime" class="sleep-time"></div>

      <button id="sleepBtn">寝る</button>
      <button id="wakeBtn" style="display:none;">起きた</button>

      <div class="subtext">
        ※睡眠時間が7時間以上だと、猫が元気になります。
      </div>
    </div>
  </div>

  <script>
    const sleepBtn = document.getElementById("sleepBtn");
    const wakeBtn = document.getElementById("wakeBtn");
    const cat = document.getElementById("cat");
    const status = document.getElementById("status");
    const sleepTimeEl = document.getElementById("sleepTime");

    let sleepStart = null;

    function formatTime(date) {
      const h = String(date.getHours()).padStart(2, "0");
      const m = String(date.getMinutes()).padStart(2, "0");
      return `${h}:${m}`;
    }

    sleepBtn.addEventListener("click", () => {
      sleepStart = new Date();
      status.textContent = `就寝時刻：${formatTime(sleepStart)}　おやすみなさい。`;
      sleepTimeEl.textContent = "";
      cat.textContent = "😴"; // 眠っている猫
      sleepBtn.style.display = "none";
      wakeBtn.style.display = "inline-block";
    });

    wakeBtn.addEventListener("click", () => {
      if (!sleepStart) return;

      const wakeTime = new Date();
      const diffHours =
        (wakeTime.getTime() - sleepStart.getTime()) / 1000 / 60 / 60;

      sleepTimeEl.textContent = `睡眠時間：${diffHours.toFixed(1)} 時間`;
      wakeBtn.style.display = "none";
      sleepBtn.style.display = "inline-block";

      if (diffHours >= 7) {
        cat.textContent = "😺"; // 元気な猫
        status.textContent = `起床時刻：${formatTime(
          wakeTime
        )}　よく眠れました。`;
      } else {
        cat.textContent = "😿"; // 元気がない猫
        status.textContent = `起床時刻：${formatTime(
          wakeTime
        )}　睡眠が少なめです。`;
      }

      // 次の計測に備えて
      sleepStart = null;
    });
  </script>
</body>
</html>
